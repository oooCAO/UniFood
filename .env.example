# Пример настроек окружения для UniFood.
# Скопируйте файл в .env и подставьте свои пароли:
#   cp .env.example .env
# Реальный .env в git не попадает (он указан в .gitignore).

# --- Порты на вашем компьютере ---
# Меняйте, если порт уже занят другой программой.
WEB_PORT=8080
MYSQL_PORT=3306
MONGO_PORT=27017

# --- MySQL ---
# Имя базы, пользователь приложения и его пароль.
MYSQL_DATABASE=unifood
MYSQL_USER=unifood_user
MYSQL_PASSWORD=change_me_mysql
# Пароль администратора MySQL. Нужен только для обслуживания базы.
MYSQL_ROOT_PASSWORD=change_me_root

# --- MongoDB ---
# База приложения и root-пользователь, которого создаёт официальный образ.
MONGO_INITDB_DATABASE=unifood
MONGO_INITDB_ROOT_USERNAME=unifood_user
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo

# Внутренние адреса (mysql:3306, mongo:27017) прописаны в docker-compose.yml:
# внутри docker-сети контейнеры видят друг друга по именам сервисов, а не через localhost.
